# Configurações do Painel Administrativo Voxel Lab

# Caminho absoluto ou relativo para a pasta do repositório do catálogo local
# Exemplo Windows: C:/git/VOXEL LAB
# Exemplo Linux/Mac: /home/user/voxel-lab
CATALOG_REPO_PATH=C:/git/VOXEL LAB

# Configurações do Git
GIT_BRANCH=main
GIT_REMOTE=origin
ENABLE_AUTO_PUSH=True

# Configurações do Servidor Local
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
FLASK_DEBUG=True
SECRET_KEY=voxel-lab-admin-secret-dev-key-change-in-production

# URL do Catálogo em Produção (Vercel)
VERCEL_DEPLOY_URL=https://voxel-lab-black.vercel.app

